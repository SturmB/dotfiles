#!/usr/bin/env bash
# Persist hyprlock diagnostics to the journal without recording password
# contents. Set HYPRLOCK_VERBOSE=1 for a one-off full trace.
args=()
if [[ ${HYPRLOCK_VERBOSE:-0} == 1 ]]; then
    args+=(--verbose)
fi

exec systemd-cat --identifier=hyprlock-debug --level-prefix=false \
    /usr/bin/hyprlock "${args[@]}" "$@"
